POST {{host}}/admin/weather
Content-Type: application/json

{
  "date": "2026-10-20",
  "location": "Budapest",
  "temp_min": 10,
  "temp_max": 19,
  "weather_type": "Cloudy",
  "precipitation": 2,
  "precipitation_probability": 30,
  "wind_speed": 12,
  "wind_direction": "N",
  "humidity": 65,
  "pressure": 1013,
  "uv_index": 2
}

